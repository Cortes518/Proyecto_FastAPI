{
  "version": 2,
  "installCommand": "pip install -r frontend/requirements.txt",
  "buildCommand": "python frontend/manage.py collectstatic --noinput",
  "builds": [
    {
      "src": "frontend/frontend/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/frontend/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/frontend/wsgi.py"
    }
  ]
}
