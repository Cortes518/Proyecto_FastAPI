{
  "version": 2,
  "buildCommand": "pip install -r requirements.txt && python backend/manage.py collectstatic --noinput",
  "framework": "fastapi",
  "functions": {
    "backend/main.py": {
      "memory": 3008,
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/main.py"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SECRET_KEY": {
      "description": "Django secret key",
      "required": true
    },
    "FASTAPI_ENV": "production",
    "DEBUG": "False"
  },
  "regions": ["iad1", "sfo1"],
  "buildLogs": {
    "enabled": true
  }
}
